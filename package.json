{
  "name": "uv-link",
  "productName": "Uv Link",
  "private": true,
  "version": "1.0.0",
  "description": "Cast your PC screen and sound to any TV on your Wi-Fi.",
  "author": "Uv Link",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server/uvlinkServer.ts --bundle --platform=node --format=cjs --target=node22 --external:vite --external:bufferutil --external:utf-8-validate --outfile=dist-server/uvlinkServer.cjs --log-level=warning",
    "build:icons": "electron scripts/render-icons.cjs",
    "build:tv": "node scripts/build-tv-apk.mjs",
    "build:pc": "npm run build && npm run build:server && electron-builder --win --x64",
    "release": "npm run build:tv && npm run build:pc",
    "electron": "npm run build && npm run build:server && electron .",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "bonjour-service": "^1.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.uvlink.pc",
    "productName": "Uv Link",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-main.cjs",
      "dist/**/*",
      "dist-server/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "release",
        "to": "downloads",
        "filter": ["UvLink-TV.apk"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Uv Link",
      "artifactName": "UvLink-PC-Setup.exe"
    }
  }
}
